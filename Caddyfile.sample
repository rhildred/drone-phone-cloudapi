drone-server.local {
    # 1. Serve your static frontend code
    root * /var/www/drone-viewer
    file_server

    # 2. Proxy Mosquitto WebSockets 
    handle_path /mqtt {
        reverse_proxy localhost:9001
    }

    # 3. Proxy MediaMTX WebRTC Signaling (Both WHIP and WHEP)
    handle_path /mediamtx/* {
        reverse_proxy localhost:8889 {
            # Instructs Caddy to forward streaming chunk blocks instantly 
            flush_interval -1 
        }
    }
}
